# ============================================================
# Secrets & Credentials
# ============================================================
.env
.kdp-session/
.env.*
*.pem
*.key
*.p12
secrets/
credentials/

# Ausnahme: die .env.example-Vorlage MUSS ins Repo,
# damit andere Mitwirkende die nötigen Variablen sehen.
!.env.example

# ============================================================
# OS-Müll
# ============================================================
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ============================================================
# Python
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ============================================================
# IDE / Editor
# ============================================================
.vscode/
.idea/
*.swp
*.swo
*~

# ============================================================
# Memory Bank (bewusst nicht gepflegt)
# ============================================================
/memory-bank/

# ============================================================
# Temporäre Debug-/Log-Ausgaben im Repo-Root
# ============================================================
/status_mark*.txt
/status_list.txt
/status_summary.txt
/status_diff*.txt
/debug_*.txt
/dryrun.txt
/extract_run.txt
/final_status.txt
/.dashboard-batch-job.json
/var/
*.bak
*.bak-*
*.tmp
*.orig

# ============================================================
# JavaScript / Frontend
# ============================================================
node_modules/
webapp/frontend/dist/
webapp/frontend/.vite/
webapp/frontend/.npm-cache/
webapp/frontend/*.tsbuildinfo

# ============================================================
# Lokale Arbeits-/Staging-Reste (kein Teil eines Buchpakets)
# ============================================================
/staging/

# KDP-Adapter: Laufzeit-Snapshots, keine zweite Metadatenquelle
books/*/work/kdp/

# Higgsfield-Bildwiederherstellung: nur verified/ + Manifeste im Repo,
# grosse Originale/Sichtungskopien/Backups bleiben lokal
books/*/work/image-recovery/*/originals/
books/*/work/image-recovery/*/jpg/
books/*/work/image-recovery/*/before/

# KDP-Sitzung (lokale Laufzeitdaten)
.kdp-session/
# Grosse, regenerierbare Medien (Druckoriginale, Audio, Video, Clips) werden
# pro Buchpaket ausgeschlossen: books/<id>/.gitignore, verwaltet von
# `py -3 tools/sync_book_gitignore.py`. Muster in
# config/gitignore-assets.yaml, Schalter pro Buch in book.yaml
# (`gitignore.large_assets`). Die E-Reader-Fassung in assets/chapter bzw.
# assets/scene bleibt bewusst im Repo, nur assets/master/ nicht.
